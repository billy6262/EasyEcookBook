# ─────────────────────────────────────────────────────────────────────────────
# EasyEcookBook — Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Django ────────────────────────────────────────────────────────────────────
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-generate-a-50-char-random-string

ALLOWED_HOSTS=localhost,yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost,https://yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
POSTGRES_DB=easyecookbook
POSTGRES_USER=easyecookbook
POSTGRES_PASSWORD=change-me-strong-db-password

# ── MinIO (S3-compatible media storage) ──────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-strong-minio-password
MINIO_BUCKET=media
# Internal protocol for backend -> MinIO traffic. Keep false for the Docker network.
MINIO_USE_HTTPS=false
# Public hostname used by browsers. Production Nginx proxies /media/ to MinIO.
MINIO_PUBLIC_ENDPOINT=yourdomain.com

# ── HTTP Port ─────────────────────────────────────────────────────────────────
# Production Nginx binds to loopback by default so a TLS proxy can own public traffic.
HTTP_BIND=127.0.0.1
HTTP_PORT=80

# ── Email (SMTP — required for registration & password reset) ─────────────────
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=your@email.com
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# ── Registration ──────────────────────────────────────────────────────────────
# Controls email verification behaviour: 'mandatory' | 'optional' | 'none'
ACCOUNT_EMAIL_VERIFICATION=mandatory

# ── Read-only demo ────────────────────────────────────────────────────────────
# Provision this account with `python manage.py seed_demo` before enabling demo mode.
DEMO_ACCOUNT_EMAIL=demo@easyecookbook.local
DEMO_SHOWCASE_EMAIL=showcase@yourdomain.com

# ── Search (optional — only needed with: docker compose --profile search up) ──
MEILI_MASTER_KEY=change-me-meilisearch-master-key
# Set to false to force PostgreSQL full-text search even when the MeiliSearch
# container is running. Automatically falls back to PostgreSQL if MeiliSearch
# is enabled but unreachable.
MEILISEARCH_ENABLED=true

# ── Async Tasks (uncomment when enabling Celery support) ─────────────────────
# REDIS_URL=redis://redis:6379/0
